{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "platform-api chart values",
  "type": "object",
  "required": ["environment", "image"],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["dev", "staging", "prod"]
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "roleArn": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": { "create": { "type": "boolean" } }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "containerPorts": {
      "type": "object",
      "properties": {
        "http": { "type": "integer" },
        "management": { "type": "integer" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer" },
        "managementPort": { "type": "integer" },
        "annotations": { "type": "object" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "probes": { "type": "object" },
    "lifecycle": {
      "type": "object",
      "properties": { "preStopSleepSeconds": { "type": "integer", "minimum": 0 } }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "updateStrategy": {
      "type": "object",
      "properties": {
        "maxSurge": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "extraEnv": { "type": "array" },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"] },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"] },
        "behavior": { "type": "object" }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "whenUnsatisfiable": { "type": "string", "enum": ["DoNotSchedule", "ScheduleAnyway"] }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "pathType": { "type": "string" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressControllerNamespace": { "type": "string" },
        "monitoringNamespace": { "type": "string" },
        "dnsNamespace": { "type": "string" },
        "extraEgress": { "type": "array" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "path": { "type": "string" },
        "additionalLabels": { "type": "object" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "additionalLabels": { "type": "object" },
        "thresholds": {
          "type": "object",
          "properties": {
            "errorRatePercent": { "type": "number" },
            "latencyP95Seconds": { "type": "number" },
            "cpuPercent": { "type": "number" },
            "memoryPercent": { "type": "number" },
            "restartsPerHour": { "type": "number" }
          }
        }
      }
    },
    "argoRollouts": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "steps": { "type": "array" },
        "analysis": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "prometheusAddress": { "type": "string", "minLength": 1 },
            "successRateThreshold": { "type": "string" },
            "intervalSeconds": { "type": "integer", "minimum": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "failureLimit": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "refreshInterval": { "type": "string" },
        "secretStoreRef": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string", "enum": ["SecretStore", "ClusterSecretStore"] }
          }
        },
        "data": { "type": "array" }
      }
    },
    "otel": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "samplerArg": { "type": "string" }
      }
    },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" }
  }
}
