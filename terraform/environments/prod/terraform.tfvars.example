region      = "eu-west-1"
environment = "prod"
owner       = "platform-team"

vpc_cidr             = "10.30.0.0/16"
azs                  = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]
private_subnet_cidrs = ["10.30.0.0/20", "10.30.16.0/20", "10.30.32.0/20"]
public_subnet_cidrs  = ["10.30.128.0/24", "10.30.129.0/24", "10.30.130.0/24"]

kubernetes_version  = "1.31"
node_instance_types = ["m6i.large"]
node_desired_size   = 4
node_min_size       = 4
node_max_size       = 12

gha_oidc_enabled = false
gha_repository   = "OWNER/kubernetes-platform-gitops"
