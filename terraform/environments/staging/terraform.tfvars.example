region      = "eu-west-1"
environment = "staging"
owner       = "platform-team"

vpc_cidr             = "10.20.0.0/16"
azs                  = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]
private_subnet_cidrs = ["10.20.0.0/20", "10.20.16.0/20", "10.20.32.0/20"]
public_subnet_cidrs  = ["10.20.128.0/24", "10.20.129.0/24", "10.20.130.0/24"]

kubernetes_version  = "1.31"
node_instance_types = ["t3.large"]
node_desired_size   = 3
node_min_size       = 3
node_max_size       = 8

gha_oidc_enabled = false
gha_repository   = "OWNER/kubernetes-platform-gitops"
