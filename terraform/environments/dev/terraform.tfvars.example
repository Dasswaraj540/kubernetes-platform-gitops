region      = "eu-west-1"
environment = "dev"
owner       = "platform-team"

vpc_cidr             = "10.10.0.0/16"
azs                  = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]
private_subnet_cidrs = ["10.10.0.0/20", "10.10.16.0/20", "10.10.32.0/20"]
public_subnet_cidrs  = ["10.10.128.0/24", "10.10.129.0/24", "10.10.130.0/24"]

kubernetes_version  = "1.31"
node_instance_types = ["t3.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4

gha_oidc_enabled = false
gha_repository   = "OWNER/kubernetes-platform-gitops"
